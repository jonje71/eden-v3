# EDEN v3 — Environment Variables Template
# Copy this file to ".env" and fill in your real values
# DO NOT commit your real .env file — it's in .gitignore

# Supabase (get from: https://supabase.com/dashboard -> Project -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Optional: Google Gemini AI API key
# GEMINI_API_KEY=your-gemini-key-here
